# -----------------------------------------------------------------------------
# Runtime Environment Configuration
# -----------------------------------------------------------------------------
SCRAPPER_MODE=development

# -----------------------------------------------------------------------------
# Redis Configuration (Distributed Queue & Deduplication)
# -----------------------------------------------------------------------------
# For local host runs outside docker:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_START_URLS_KEY=start_urls:novel_toc

# -----------------------------------------------------------------------------
# PostgreSQL Configuration (Relational Metadata Indexing)
# -----------------------------------------------------------------------------
POSTGRES_USER=scraper
POSTGRES_PASSWORD=scraper
POSTGRES_DB=scraper
POSTGRES_PORT=5432
POSTGRES_DSN=dbname=scraper user=scraper password=scraper host=localhost port=5432

# -----------------------------------------------------------------------------
# Crawler Tuning & Storage Limits
# -----------------------------------------------------------------------------
CONCURRENT_REQUESTS=32
CONCURRENT_REQUESTS_PER_DOMAIN=6
DOWNLOAD_DELAY=0.25
DOWNLOAD_TIMEOUT=30
RETRY_TIMES=3

# Output directory for partitioned novel archives
RAW_OUT_DIR=./data/raw/novels
STORAGE_MAX_GB=5.0
STORAGE_MAX_OPEN_FILES=64
ROLL_MINUTES=60

# -----------------------------------------------------------------------------
# Observability & Metrics
# -----------------------------------------------------------------------------
METRICS_PORT=8000
LOG_LEVEL=INFO
